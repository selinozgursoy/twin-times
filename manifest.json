{
  "manifest_version": 3,
  "name": "TwinTimes",
  "version": "0.4.0",
  "description": "A local-first personal news intelligence dashboard.",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "Open TwinTimes",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
